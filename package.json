{
  "name": "@sx/ui",
  "version": "0.1.0",
  "description": "画面の共通部品（React＋Tailwind v4）と、画面ファイルの書き方・部品の台帳の検査",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./check": {
      "types": "./check/index.ts",
      "default": "./dist/check/index.js"
    }
  },
  "files": [
    "src",
    "gallery",
    "check",
    "dist/check",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test test/*.test.ts",
    "check": "sh scripts/check.sh",
    "prepack": "rm -rf dist && tsc -p tsconfig.check.json",
    "release": "sh scripts/release.sh"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "lucide-react": "1.55.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
